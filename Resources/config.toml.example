# tiler example configuration
# Copy to ~/.config/tiler/config.toml and uncomment/modify as needed.

# ── General ──────────────────────────────────────────────────────────────

[general]
# Gap between the screen edge and the outermost windows (points).
outer_gaps = 8
# Gap between windows stacked vertically in the same column.
inner_gaps = 6
# Gap between adjacent columns.
column_gaps = 8

# ── Layout ───────────────────────────────────────────────────────────────

[layout]
# Width fraction for newly-created columns (0.0–1.0 of usable width).
default_column_width = 0.5
# Whether to scroll the viewport so the focused column stays centred.
center_focused_column = true

# ── Workspaces ───────────────────────────────────────────────────────────

[workspaces]
# Number of workspaces (1…count). Default is 9.
count = 9

# ── Keybinds ─────────────────────────────────────────────────────────────
# Each [[keybind]] entry maps a key combination to an action.
# Available actions:
#   focus_column_left       focus_column_right
#   move_column_left        move_column_right
#   focus_window_up         focus_window_down
#   move_window_up          move_window_down
#   focus_workspace <n>     move_to_workspace <n>
#   increase_column_width   decrease_column_width
#   toggle_column_tabbed    close_window        toggle_fullscreen
#
# Modifier prefixes: ctrl, alt/option, cmd/command, shift
# Key names: a-z, 0-9, f1-f12, space, return, tab, escape, comma, period,
#            slash, semicolon, quote, backtick, backslash, minus, equal,
#            bracketleft, bracketright, left, right, up, down

[[keybind]]
keys = "ctrl+alt+h"
action = "focus_column_left"

[[keybind]]
keys = "ctrl+alt+l"
action = "focus_column_right"

[[keybind]]
keys = "ctrl+alt+j"
action = "focus_window_down"

[[keybind]]
keys = "ctrl+alt+k"
action = "focus_window_up"

[[keybind]]
keys = "ctrl+alt+shift+h"
action = "move_column_left"

[[keybind]]
keys = "ctrl+alt+shift+l"
action = "move_column_right"

[[keybind]]
keys = "ctrl+alt+shift+j"
action = "move_window_down"

[[keybind]]
keys = "ctrl+alt+shift+k"
action = "move_window_up"

# Workspace switching (1–9)
[[keybind]]
keys = "ctrl+alt+1"
action = "focus_workspace"
args = ["1"]

[[keybind]]
keys = "ctrl+alt+2"
action = "focus_workspace"
args = ["2"]

# ... add more workspace bindings as needed

[[keybind]]
keys = "ctrl+alt+shift+1"
action = "move_to_workspace"
args = ["1"]

[[keybind]]
keys = "ctrl+alt+shift+2"
action = "move_to_workspace"
args = ["2"]

# ... add more move-to-workspace bindings as needed

[[keybind]]
keys = "ctrl+alt+comma"
action = "decrease_column_width"

[[keybind]]
keys = "ctrl+alt+period"
action = "increase_column_width"

[[keybind]]
keys = "ctrl+alt+t"
action = "toggle_column_tabbed"

[[keybind]]
keys = "ctrl+alt+q"
action = "close_window"

# ── App Rules ───────────────────────────────────────────────────────────
# Per-application overrides. `app` is matched against the app bundle name
# or process name (case-insensitive substring match).
#
# `action` can be "float" to exclude the app from tiling.
# `column_width` sets a preferred width fraction for windows of that app.

# [[app_rule]]
# app = "Finder"
# action = "float"

# [[app_rule]]
# app = "Slack"
# column_width = 0.4
